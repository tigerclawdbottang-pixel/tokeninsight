{
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "api.github.com",
        "codeload.github.com",
        "*.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "docs.anthropic.com",

        "semianalysis.com",
        "*.semianalysis.com",

        "openrouter.ai",
        "*.openrouter.ai",
        "fireworks.ai",
        "*.fireworks.ai",
        "wokey.ai",
        "*.wokey.ai",
        "cheaperinference.com",
        "*.cheaperinference.com",
        "siliconflow.cn",
        "*.siliconflow.cn",
        "string.ink",
        "*.string.ink",
        "venice.ai",
        "*.venice.ai",
        "near.ai",
        "*.near.ai",
        "api-docs.deepseek.com",
        "docs.z.ai",
        "platform.minimaxi.com",
        "platform.moonshot.cn",
        "platform.claude.com",
        "llmpricing.dev",
        "api.exchangerate-api.com",
        "open.er-api.com",

        "vast.ai",
        "*.vast.ai",
        "runpod.io",
        "*.runpod.io",
        "lambdalabs.com",
        "*.lambdalabs.com",
        "tensordock.com",
        "*.tensordock.com",
        "paperspace.com",
        "*.paperspace.com",
        "fluidstack.io",
        "*.fluidstack.io",
        "crusoe.ai",
        "*.crusoe.ai",
        "orcacompute.com",
        "*.orcacompute.com",
        "aws.amazon.com",
        "azure.microsoft.com",
        "cloud.google.com",

        "x.com",
        "*.x.com",
        "facebook.com",
        "*.facebook.com",
        "reddit.com",
        "*.reddit.com",
        "discord.com",
        "*.discord.com",
        "t.me",
        "*.t.me",
        "news.ycombinator.com",
        "qzone.qq.com",
        "xiaohongshu.com",
        "*.xiaohongshu.com"
      ],
      "allowLocalBinding": true
    }
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:semianalysis.com)",
      "WebFetch(domain:*.semianalysis.com)",
      "WebFetch(domain:openrouter.ai)",
      "WebFetch(domain:fireworks.ai)",
      "WebFetch(domain:venice.ai)",
      "WebFetch(domain:siliconflow.cn)",
      "WebFetch(domain:vast.ai)",
      "WebFetch(domain:runpod.io)"
    ]
  }
}
